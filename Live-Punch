<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Corporate Field Attendance Ledger</title>
    <style>
        body { font-family: 'Segoe UI', Arial, sans-serif; text-align: center; padding: 40px; background-color: #f4f4f9; color: #333; }
        .box { background: white; padding: 40px; border-radius: 12px; box-shadow: 0px 4px 20px rgba(0,0,0,0.08); display: inline-block; width: 90%; max-width: 420px; }
        h2 { margin-bottom: 5px; color: #1e3a8a; }
        p.subtitle { color: #6b7280; font-size: 14px; margin-bottom: 30px; }
        input { padding: 14px; width: 85%; margin-bottom: 25px; font-size: 16px; border-radius: 6px; border: 1px solid #d1d5db; text-align: center; font-weight: bold; }
        input:focus { outline: none; border-color: #2563eb; box-shadow: 0 0 0 3px rgba(37,99,235,0.15); }
        button { padding: 14px 20px; font-size: 16px; margin: 8px; border: none; border-radius: 6px; cursor: pointer; color: white; font-weight: bold; width: 45%; transition: transform 0.1s; }
        button:active { transform: scale(0.98); }
        .in { background-color: #10b981; }
        .in:hover { background-color: #059669; }
        .out { background-color: #ef4444; }
        .out:hover { background-color: #dc2626; }
        #msg { margin-top: 25px; font-size: 15px; background: #f0fdf4; color: #166534; padding: 15px; border-radius: 6px; display: none; text-align: left; line-height: 1.6; border: 1px solid #bbf7d0; }
        .error-msg { background: #fef2f2 !important; color: #991b1b !important; border-color: #fca5a5 !important; }
    </style>
</head>
<body>
<div class="box">
    <h2>📱 Staff Attendance Ledger</h2>
    <p class="subtitle">Cloud-Linked Smart Tracker App</p>

    <input type="number" id="empId" placeholder="Enter Employee ID (e.g., 555)"><br>
    <button class="in" onclick="punch('IN')">PUNCH IN</button>
    <button class="out" onclick="punch('OUT')">PUNCH OUT</button>
    <div id="msg"></div>
</div>

<script>
    const employees = {
        500: "Mohamad Khalil Hamad (Engineer)",
        501: "Zakaria A M Zayed (Engineer)",
        503: "Abdul Hannan (Technician)",
        522: "Basma Rostom (Engineer)",
        525: "Mujeeb Rahman (Engineer)",
        528: "Monir Ahmmed (Technician)",
        536: "Ashraf Ahmed (Driver)",
        548: "Balwinder Singh (Technician)",
        551: "Lalachan Thankachan (Technician)",
        555: "Sreejith Chettupuzha (Engineer)",
        560: "MD. Julfiker Ali (Technician)",
        561: "Dilip Kumar (Technician)",
        565: "Mohammed Imran Sheikh (Safety Supervisor)",
        567: "Abdelrehim Gamal (Technician)",
        583: "Imran Ahmad (Technician)",
        588: "Bharathi Mohan (Technician)",
        591: "Mohammed Nidal (Engineer)",
        595: "Ahmed Alqishawi (Technician)",
        636: "Osama Abu Hishmeh (Engineer)"
    };

    function punch(type) {
        const id = document.getElementById("empId").value;
        const msg = document.getElementById("msg");
        msg.style.display = "block";
        msg.className = "";

        if (!id || !employees[id]) {
            msg.innerHTML = "🚨 <b>Access Denied:</b> Invalid Employee ID. Please enter a valid registration code.";
            msg.classList.add("error-msg");
            return;
        }

        if (!navigator.geolocation) {
            msg.innerText = "❌ Security Block: Hardware device does not support GPS tracking components.";
            msg.classList.add("error-msg");
            return;
        }

        msg.innerText = "⏳ Requesting secure GPS tracking authorization...";

        // 🎯 FORCED HIGH ACCURACY HARDWARE PARAMETERS LINKED HERE
        const gpsOptions = {
            enableHighAccuracy: true, 
            timeout: 12000,           
            maximumAge: 0             
        };

        navigator.geolocation.getCurrentPosition(async function (pos) {
            const lat = pos.coords.latitude;
            const lon = pos.coords.longitude;

            msg.innerText = "⏳ Synchronizing with cloud database... (Wait...)";

            const cloudUrl = "https://company-attendance-backend.onrender.com/api/punch";

            try {
                const res = await fetch(cloudUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ emp_id: parseInt(id), punch_type: type, latitude: lat, longitude: lon })
                });

                const data = await res.json();

                if (!res.ok) {
                    throw new Error(data.detail || ("Server error " + res.status));
                }

                msg.innerHTML = `
                    ✅ <b>Transaction Recorded Successfully!</b><br><br>
                    👤 <b>Staff Name:</b> ${employees[id]}<br>
                    🔁 <b>Type:</b> ${type}<br>
                    🕒 <b>Timestamp:</b> ${new Date().toLocaleString()}<br>
                    📍 <b>Coordinates:</b> ${lat}, ${lon}<br><br>
                    🗺️ <a href="${data.maps_url}" target="_blank" style="color: #2563eb; font-weight: bold; text-decoration: underline;">Open Google Maps Location</a>
                `;
            } catch (err) {
                msg.innerText = "❌ Transaction Failed: " + err.message;
                msg.classList.add("error-msg");
            }

        }, function () {
            msg.innerText = "🔒 Security Block: GPS Permission Denied. Please enable location services on your device configuration.";
            msg.classList.add("error-msg");
        }, gpsOptions); // 👈 GPS Hardware settings injected perfectly here
    }
</script>
</body>
</html>




